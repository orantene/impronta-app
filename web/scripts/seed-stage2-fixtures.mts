/**
 * Business Suite Stage 2 unified fixture seed (TUL-1519 / TUL-1427 "DRAFT — Unified Stage 2 fixture set").
 * STAGING ONLY (fxlankepwnvelxjrahwk). Additive: new rows only, ids s2Id(key) = stableId("s2:" + key), ON CONFLICT DO NOTHING,
 * so a re-run is a no-op. Reuses the #4048 guards and the Group-6 workspace/membership rows as clone templates (Group-6 must be applied).
 *
 * Modes (default: read-only DRY RUN that writes nothing):
 *   (none)                              plan: target check, guards, row-count plan per table, present/absent, schema + collision check, blocked items
 *   --selftest                          BEGIN; apply; read back; cleanup; ROLLBACK; then re-check 0 rows left (ephemeral credentials, nothing written to disk)
 *   --apply --backup-file <f>           write and COMMIT; credentials are generated into the local gitignored mode-600 web/.env.stage2-seed.local
 *   --cleanup [--apply --backup-file f] delete ONLY this seed's rows; REFUSES when sales history hangs off a fixture row
 *   --only T1,T2                        limit the clusters
 * Env: DATABASE_URL from the process env or --env-file. Passwords and PINs are generated by this script, never read from the
 * environment, never printed, never in a row, a backup or a log.
 *
 * Run from web/: npx tsx scripts/seed-stage2-fixtures.mts --env-file <tmp> [--selftest | --apply --backup-file <f>]
 */
import { existsSync, readFileSync, writeFileSync } from "node:fs";

import { STAGING_MARKER_AGENCY_ID, parseEnvText } from "./lib/group6-fixtures.mjs";
import { G6_REQUIRED, HUB_TENANT_ID } from "./lib/failed-cards-ops.mjs";
import { checkS2Target, summarise } from "./lib/stage2-guards.mjs";
import { S2_FIXTURES, buildStage2Plan, resolveStage2, verifyS2Plan } from "./lib/stage2-plan.mjs";
import { readBack } from "./lib/stage2-readback.mjs";
import { SEED_CONFIG_PATH, loadSeedConfig, pinName, pwName, resolveSecrets, writeSeedConfig } from "./lib/stage2-secrets.mjs";

type Row = Record<string, unknown>;
type Op = { fx: string; kind: string; table: string; key: string; id: string | null; row?: Row; set?: Row; merge?: Row; conflict?: string[] | null; template?: Row; userId?: string; secretKey?: string; touchesExisting?: string };
type PgClient = { connect(): Promise<void>; query(text: string, params?: unknown[]): Promise<{ rows: Row[]; rowCount: number | null }>; end(): Promise<void> };
const PG_MODULE = "pg";
const pgMod = (await import(PG_MODULE)) as { default: { Client: new (cfg: { connectionString?: string; ssl?: unknown }) => PgClient } };

const TAG = "[stage2-fixtures]";
function die(msg: string, code = 1): never {
  console.error(`${TAG} ${msg}`);
  process.exit(code);
}

// ------------------------------------------------------------------ args
const argv = process.argv.slice(2);
const flag = (n: string) => argv.includes(n);
const val = (n: string) => {
  const i = argv.indexOf(n);
  const v = i >= 0 ? argv[i + 1] : undefined;
  return v && !v.startsWith("--") ? v : null;
};
const KNOWN = new Set(["--apply", "--cleanup", "--selftest", "--help", "-h", "--env-file", "--backup-file", "--only", "--stripe"]);
const unknown = argv.filter((a) => a.startsWith("-") && !KNOWN.has(a));
if (flag("--help") || flag("-h")) {
  console.log("usage: seed-stage2-fixtures.mts [--env-file p] [--only T1,T2] [--selftest | --apply --backup-file p | --cleanup [--apply --backup-file p]]");
  process.exit(0);
}
if (unknown.length) die(`unknown argument ${unknown.join(" ")}`, 2);
if (flag("--stripe")) die("the Stripe TEST step (Connect accounts + test clocks) is not built yet (push 3)", 2);
const apply = flag("--apply");
const cleanupMode = flag("--cleanup");
const selftest = flag("--selftest");
const backupFile = val("--backup-file");
if (selftest && (apply || cleanupMode)) die("--selftest cannot be combined with --apply or --cleanup", 2);
if (apply && !backupFile) die("--apply requires --backup-file <path> (it records every pre-existing row the run changes)", 2);
if (backupFile && existsSync(backupFile)) die(`--backup-file ${backupFile} already exists; pass a new path (never overwritten)`, 2);
const only = val("--only")?.split(",").map((s) => s.trim().toUpperCase()).filter(Boolean) ?? null;
for (const f of only ?? []) if (!S2_FIXTURES.includes(f)) die(`unknown cluster ${f} (built: ${S2_FIXTURES.join(",")})`, 2);

const env: Record<string, string | undefined> = { ...process.env };
const envFile = val("--env-file");
if (envFile) Object.assign(env, parseEnvText(readFileSync(envFile, "utf8")));
const targetVerdict = checkS2Target(env);
if (!targetVerdict.ok) die(`refusing to run:\n  - ${targetVerdict.reasons.join("\n  - ")}`, 2);

const mode = cleanupMode ? (apply ? "cleanup-apply" : "cleanup-plan") : selftest ? "selftest" : apply ? "apply" : "plan";
const sets = resolveStage2(only);
const client = new pgMod.default.Client({ connectionString: env.DATABASE_URL, ssl: { rejectUnauthorized: false } });
await client.connect();
const q = (text: string, params: unknown[] = []) => client.query(text, params);
const J = (v: unknown) => JSON.stringify(v);

const created = new Set<string>();
const counts: Record<string, { created: number; existed: number; updated: number }> = {};
const bump = (t: string, k: "created" | "existed" | "updated") => ((counts[t] ??= { created: 0, existed: 0, updated: 0 })[k] += 1);
const backup: { target: string; mode: string; at: string; updated: Array<{ table: string; id: string; before: Row }>; deleted: Array<{ table: string; id: string; row: Row }> } = {
  target: "fxlankepwnvelxjrahwk", mode, at: new Date().toISOString(), updated: [], deleted: [],
};
const saveBackup = () => {
  if (backupFile) writeFileSync(backupFile, JSON.stringify(backup, null, 2), { mode: 0o600 });
};
/** Credentials live only in this map (and, on --apply, the local mode-600 seed config). */
let secrets = new Map<string, string>();

// ------------------------------------------------------------------ guards (run before EVERY write batch)
const LIVE_COLUMNS = ["talent_offerings.pos_enabled"];
/** Pre-existing talent facts, resolved read-only in context(): the hub talent TAL-93900 (additive rows only) and the ids no op may name. */
let hubCtx: { talentId: string; tenantId: string; hasPayout: boolean } | null = null;
let forbiddenTalentIds: string[] = [];
const guardCtx = () => ({
  externalTenantIds: new Set(hubCtx ? [hubCtx.tenantId] : []),
  existingTalentIds: new Set([...(hubCtx ? [hubCtx.talentId] : []), ...forbiddenTalentIds]),
});
async function assertBatchGuards(label: string, ops: Op[]) {
  const t = checkS2Target(env);
  if (!t.ok) throw new Error(`${label}: target guard failed: ${t.reasons.join("; ")}`);
  const marker = await q("select 1 from public.agencies where id = $1", [STAGING_MARKER_AGENCY_ID]);
  if (!marker.rowCount) throw new Error(`${label}: staging marker agency (qa-journeys) not found; not the staging database`);
  const v = verifyS2Plan(ops, guardCtx());
  if (!v.ok) throw new Error(`${label}: plan guard failed:\n  - ${v.problems.join("\n  - ")}`);
  const ws = [...v.tenantIds];
  const clash = await q("select id::text id, slug from public.agencies where id = any($1::uuid[]) and slug not like 's2-%'", [ws]);
  if (clash.rowCount) throw new Error(`${label}: a fixture tenant id belongs to a non-fixture workspace; refusing`);
  const hosts = ops.filter((o) => o.table === "public.agency_domains").map((o) => o.row?.hostname);
  const hostClash = await q("select hostname from public.agency_domains where hostname = any($1::text[]) and tenant_id <> all($2::uuid[])", [hosts, ws]);
  if (hostClash.rowCount) throw new Error(`${label}: a fixture hostname is held by another tenant; refusing`);
  const pool = await q("select count(*)::int n from public.agency_domains where hostname ~* '(^|[^a-z0-9])qa-[1-6]\\.' and tenant_id = any($1::uuid[])", [ws]);
  if ((pool.rows[0].n as number) > 0) throw new Error(`${label}: a fixture tenant is attached to a qa-1..qa-6 host; refusing`);
}

async function context() {
  const marker = await q("select 1 from public.agencies where id = $1", [STAGING_MARKER_AGENCY_ID]);
  if (!marker.rowCount) die("staging marker agency (qa-journeys) not found: not the staging database, refusing", 2);
  for (const [table, ids] of Object.entries(G6_REQUIRED)) {
    const r = await q(`select count(*)::int n from ${table} where id = any($1::uuid[])`, [ids]);
    if ((r.rows[0].n as number) !== ids.length) die(`Group-6 fixtures missing in ${table} (${r.rows[0].n}/${ids.length}): apply seed-group6-staging-fixtures.mts first`, 2);
  }
  const have = new Set<string>();
  const cols = await q("select table_name || '.' || column_name c from information_schema.columns where table_schema = 'public' and table_name || '.' || column_name = any($1::text[])", [LIVE_COLUMNS]);
  for (const r of cols.rows) have.add(r.c as string);
  // Talents: TAL-93900 is the only pre-existing one this seed may add rows next to; TAL-93938 / TAL-93940 may never be named.
  const forbidden = await q("select id::text id, user_id::text uid from public.talent_profiles where profile_code = any($1)", [["TAL-93938", "TAL-93940"]]);
  forbiddenTalentIds = forbidden.rows.flatMap((r) => [r.id, r.uid]).filter(Boolean) as string[];
  const hubRow = await q("select id::text id from public.talent_profiles where profile_code = 'TAL-93900'");
  hubCtx = null;
  if (hubRow.rowCount) {
    const talentId = hubRow.rows[0].id as string;
    const pay = await q("select 1 from public.payout_accounts where tenant_id = $1 and owner_type = 'talent' and owner_id = $2 and status in ('pending_verification','connected')", [HUB_TENANT_ID, talentId]);
    hubCtx = { talentId, tenantId: HUB_TENANT_ID, hasPayout: Boolean(pay.rowCount) };
  }
  return { now: new Date(), has: (c: string) => have.has(c), hub: hubCtx };
}

// ------------------------------------------------------------------ executors
async function execInsert(op: Op) {
  const row = op.row as Row;
  const cols = Object.keys(row);
  const conflict = op.conflict ? `(${op.conflict.map((c) => `"${c}"`).join(",")})` : "";
  const r = await q(`insert into ${op.table} (${cols.map((c) => `"${c}"`).join(",")}) values (${cols.map((_, i) => `$${i + 1}`).join(",")}) on conflict ${conflict} do nothing`, cols.map((c) => row[c]));
  if ((r.rowCount ?? 0) > 0) {
    bump(op.table, "created");
    if (op.id) created.add(op.id);
  } else bump(op.table, "existed");
}

async function writableCols(table: string): Promise<string[]> {
  const [schema, name] = table.split(".");
  const r = await q("select column_name from information_schema.columns where table_schema = $1 and table_name = $2 and is_generated = 'NEVER' order by ordinal_position", [schema, name]);
  return r.rows.map((c) => c.column_name as string);
}

async function execClone(op: Op) {
  const tpl = op.template as { id: string };
  const cols = (await writableCols(op.table)).map((c) => `"${c}"`).join(",");
  const r = await q(
    `insert into ${op.table} (${cols}) select ${cols} from (select r.* from ${op.table} s, json_populate_record(null::${op.table}, (to_jsonb(s) || $2::jsonb)::json) r where s.id = $1 limit 1) t on conflict (id) do nothing`,
    [tpl.id, J(op.row)],
  );
  if ((r.rowCount ?? 0) > 0) {
    bump(op.table, "created");
    created.add(op.id as string);
  } else {
    if (!(await q(`select 1 from ${op.table} where id = $1`, [op.id])).rowCount) throw new Error(`${op.fx} ${op.table} ${op.key}: template ${tpl.id} not found, nothing inserted`);
    bump(op.table, "existed");
  }
}

async function execAuthUser(op: Op) {
  const r = op.row as { email: string; name: string; confirmed: boolean; secretKey: string };
  if ((await q("select 1 from auth.users where id = $1", [op.id])).rowCount) {
    bump("auth.users", "existed");
    return;
  }
  const password = secrets.get(pwName(r.secretKey));
  if (!password) throw new Error(`${op.fx} ${op.key}: no generated credential for this login`);
  await q(
    `insert into auth.users (id, instance_id, aud, role, email, encrypted_password, email_confirmed_at, raw_app_meta_data, raw_user_meta_data,
       created_at, updated_at, confirmation_token, recovery_token, email_change_token_new, email_change, is_sso_user, is_anonymous)
     values ($1::uuid,'00000000-0000-0000-0000-000000000000','authenticated','authenticated',$2::text, extensions.crypt($3::text, extensions.gen_salt('bf')), ${r.confirmed ? "now()" : "null"},
       '{"provider":"email","providers":["email"]}'::jsonb, jsonb_build_object('full_name',$4::text), now(), now(), '','','','',false,false)`,
    [op.id, r.email, password, r.name],
  );
  await q(
    `insert into auth.identities (id, user_id, provider_id, provider, identity_data, last_sign_in_at, created_at, updated_at)
     values (gen_random_uuid(), $1::uuid, $1::text, 'email', jsonb_build_object('sub',$1::text,'email',$2::text,'email_verified',$3::boolean), now(), now(), now())`,
    [op.id, r.email, r.confirmed],
  );
  bump("auth.users", "created");
  created.add(op.id as string);
}

/** Update one of THIS seed's rows; a row that existed before this run is backed up first. */
async function updateOwned(table: string, id: string, set: Row) {
  const cur = await q(`select to_jsonb(t) j from ${table} t where id = $1`, [id]);
  if (!cur.rowCount) throw new Error(`${table} ${id}: row to update is missing`);
  const before = cur.rows[0].j as Row;
  if (!Object.entries(set).some(([k, v]) => J(before[k] ?? null) !== J(v ?? null))) {
    bump(table, "existed");
    return;
  }
  if (!created.has(id)) {
    backup.updated.push({ table, id, before });
    saveBackup();
  }
  const cols = Object.keys(set);
  await q(`update ${table} set ${cols.map((c, i) => `"${c}" = $${i + 2}`).join(", ")} where id = $1`, [id, ...cols.map((c) => set[c])]);
  bump(table, "updated");
}

/** The manager's PIN: a bcrypt hash at agencies.settings.people.pins.<user id> of this seed's own workspace row. Set once. */
async function execPin(op: Op) {
  const pin = secrets.get(pinName(op.secretKey as string));
  if (!pin) throw new Error(`${op.fx} ${op.key}: no generated PIN`);
  if (!created.has(op.id as string)) {
    const cur = await q("select settings from public.agencies where id = $1", [op.id]);
    backup.updated.push({ table: "public.agencies", id: op.id as string, before: { settings: cur.rows[0]?.settings ?? null } });
    saveBackup();
  }
  const r = await q(
    `update public.agencies set settings = jsonb_set(coalesce(settings, '{}'::jsonb), '{people}',
       coalesce(settings->'people', '{}'::jsonb) || jsonb_build_object('pins', coalesce(settings #> '{people,pins}', '{}'::jsonb) ||
       jsonb_build_object($2::text, extensions.crypt($3::text, extensions.gen_salt('bf')))))
     where id = $1 and (settings #>> array['people','pins',$2::text]) is null`,
    [op.id, op.userId, pin],
  );
  bump("public.agencies", (r.rowCount ?? 0) > 0 ? "updated" : "existed");
}

async function runOps(ops: Op[]) {
  await assertBatchGuards("write batch", ops);
  for (const op of ops) {
    if (op.kind === "insert") await execInsert(op);
    else if (op.kind === "clone") await execClone(op);
    else if (op.kind === "authUser") await execAuthUser(op);
    else if (op.kind === "pin") await execPin(op);
    else if (op.kind === "update") await updateOwned(op.table, op.id as string, op.set as Row);
    else throw new Error(`unknown op kind ${op.kind}`);
  }
}

// ------------------------------------------------------------------ cleanup (FK descendants of fixture ids only)
let purged = 0;
const visited = new Set<string>();
const NO_DESCENT = new Set(["agency_domains", "public.agency_domains"]);
async function purge(table: string, col: string, ids: string[], depth = 0, record = false): Promise<void> {
  if (!ids.length || depth > 8) return;
  const hasId = (await q("select 1 from information_schema.columns where table_schema = split_part($1,'.',1) and table_name = split_part($1,'.',2) and column_name = 'id'", [table.includes(".") ? table : `public.${table}`])).rowCount;
  const rows = hasId ? (await q(`select id::text id, to_jsonb(t) j from ${table} t where ${col}::text = any($1::text[])`, [ids])).rows : [];
  if (record) for (const r of rows) backup.deleted.push({ table, id: r.id as string, row: r.j as Row });
  if (rows.length) {
    const fks = await q(
      `select c.conrelid::regclass::text t, a.attname col, fa.attname refcol from pg_constraint c
         join pg_attribute a on a.attrelid = c.conrelid and a.attnum = c.conkey[1]
         join pg_attribute fa on fa.attrelid = c.confrelid and fa.attnum = c.confkey[1]
        where c.contype = 'f' and c.confrelid = $1::regclass and array_length(c.conkey, 1) = 1`,
      [table],
    );
    const rowIds = rows.map((r) => r.id as string);
    for (const fk of fks.rows as Array<{ t: string; col: string; refcol: string }>) {
      if (fk.refcol !== "id" || NO_DESCENT.has(fk.t)) continue;
      const k = `${fk.t}.${fk.col}:${rowIds.join(",")}`;
      if (visited.has(k)) continue;
      visited.add(k);
      await purge(fk.t, fk.col, rowIds, depth + 1);
    }
  }
  const del = await q(`delete from ${table} where ${col}::text = any($1::text[])`, [ids]);
  purged += del.rowCount ?? 0;
}

/** Cleanup REFUSES when anything was sold or opened on a fixture tenant: the purge would delete it. Cancel/refund in the app instead. */
async function assertNoSalesHistory(ops: Op[]) {
  const tenants = ops.filter((o) => o.table === "public.agencies" && o.kind === "clone").map((o) => o.id as string);
  const ids = (table: string) => ops.filter((o) => o.table === table && o.kind !== "update" && o.id).map((o) => o.id as string);
  const checks: Array<[string, string, string[]]> = [
    ["orders", "select count(*)::int n from public.orders where tenant_id = any($1::uuid[])", tenants],
    ["order lines", "select count(*)::int n from public.order_lines where offering_id = any($1::uuid[])", ids("public.talent_offerings")],
    ["tickets (admissions)", "select count(*)::int n from public.admissions where tenant_id = any($1::uuid[])", tenants],
    ["promo redemptions", "select count(*)::int n from public.tenant_promo_redemptions where promo_code_id = any($1::uuid[])", ids("public.tenant_promo_codes")],
    ["committed seats/units", "select count(*)::int n from public.capacity_allocations where pool_id = any($1::uuid[]) and state = 'committed'", ids("public.capacity_pools")],
  ];
  const found: string[] = [];
  for (const [label, sql, list] of checks) {
    if (!list.length) continue;
    const n = (await q(sql, [list])).rows[0].n as number;
    if (n) found.push(`${n} ${label}`);
  }
  if (found.length) throw new Error(`cleanup refused: sales history hangs off fixture rows (${found.join(", ")}). Cancel/refund in the app; this seed never deletes sales.`);
}

async function cleanup(ops: Op[], record: boolean) {
  await assertBatchGuards("cleanup batch", ops);
  await assertNoSalesHistory(ops);
  const eventIds = ops.filter((o) => o.table === "public.events" && o.kind !== "update").map((o) => o.id as string);
  if (eventIds.length) await q("update public.events set status = 'draft', published_at = null where id = any($1::uuid[]) and status <> 'cancelled'", [eventIds]); // draft-only delete rule; zero admissions proven above
  const roots = [...ops].reverse().filter((o) => o.id && (o.kind === "insert" || o.kind === "clone") && !NO_DESCENT.has(o.table));
  const seen = new Set<string>();
  for (const o of roots) {
    if (seen.has(o.id as string)) continue;
    seen.add(o.id as string);
    await purge(o.table, "id", [o.id as string], 0, record);
  }
  const users = ops.filter((o) => o.kind === "authUser").map((o) => o.id as string);
  await purge("public.profiles", "id", users, 0, record);
  purged += (await q("delete from auth.users where id = any($1::uuid[])", [users])).rowCount ?? 0;
  console.log(`${TAG} cleanup deleted ${purged} rows (fixture ids and their FK descendants only)`);
}

async function presentCount(ops: Op[]) {
  const byTable: Record<string, { n: number; of: number }> = {};
  for (const op of ops) {
    if (!op.id || op.kind === "update" || op.kind === "pin") continue;
    const table = op.kind === "authUser" ? "auth.users" : op.table;
    const r = await q(`select count(*)::int n from ${table} where id = $1`, [op.id]);
    const t = (byTable[table] ??= { n: 0, of: 0 });
    t.of += 1;
    t.n += r.rows[0].n as number;
  }
  const out: Record<string, string> = {};
  let total = 0;
  let present = 0;
  for (const [t, v] of Object.entries(byTable)) {
    out[t] = `${v.n}/${v.of}`;
    total += v.of;
    present += v.n;
  }
  return { total, present, byTable: out };
}

const COUNT_TABLES = [
  "auth.users", "auth.identities", "public.profiles", "public.agencies", "public.agency_memberships", "public.agency_business_identity", "public.agency_domains",
  "public.role_limits", "public.venues", "public.venue_service_rules", "public.venue_service_windows", "public.space_groups", "public.spaces", "public.prep_stations",
  "public.links", "public.visits", "public.pos_devices", "public.pos_shifts", "public.capacity_pools", "public.talent_offerings", "public.talent_offering_variants",
  "public.talent_offering_addons", "public.offering_components", "public.events", "public.tenant_promo_codes",
  "public.sessions", "public.session_series", "public.offering_price_phases", "public.talent_profiles", "public.agency_talent_roster",
  "public.talent_booking_hours", "public.payout_accounts",
];
async function tableCounts() {
  const out: Record<string, number> = {};
  for (const t of COUNT_TABLES) out[t] = (await q(`select count(*)::int n from ${t}`)).rows[0].n as number;
  return out;
}

// ------------------------------------------------------------------ plan-mode checks (read-only)
async function schemaAndCollisions(ops: Op[]) {
  let problems = 0;
  const colsByTable: Record<string, Set<string>> = {};
  for (const op of ops) if (op.row && op.kind !== "authUser") for (const c of Object.keys(op.row)) (colsByTable[op.table] ??= new Set()).add(c);
  for (const [table, cols] of Object.entries(colsByTable)) {
    const have = new Set(await writableCols(table));
    const gone = have.size ? [...cols].filter((c) => !have.has(c)) : ["(table missing)"];
    if (gone.length) {
      problems += gone.length;
      console.log(`  SCHEMA MISSING ${table}: ${gone.join(", ")}`);
    }
  }
  const checks: Array<[string, string]> = [["public.agencies", "slug"], ["public.agency_domains", "hostname"], ["public.events", "slug"], ["public.venues", "slug"]];
  for (const [table, col] of checks) {
    for (const op of ops.filter((o) => o.table === table && o.row?.[col])) {
      const r = await q(`select id::text id from ${table} where ${col} = $1`, [op.row?.[col]]);
      if (r.rows.find((x) => x.id !== op.id)) {
        problems += 1;
        console.log(`  COLLISION ${table}.${col} = ${String(op.row?.[col])} is held by a non-fixture row`);
      }
    }
  }
  for (const op of ops.filter((o) => o.table === "public.links")) {
    const r = await q("select id::text id from public.links where tenant_id = $1 and lower(code) = lower($2)", [op.row?.tenant_id, op.row?.code]);
    if (r.rows.find((x) => x.id !== op.id)) {
      problems += 1;
      console.log(`  COLLISION link code ${String(op.row?.code)} is held by a non-fixture link`);
    }
  }
  for (const op of ops.filter((o) => o.kind === "authUser")) {
    const r = await q("select id::text id from auth.users where lower(email) = lower($1)", [(op.row as Row).email]);
    if (r.rows.find((x) => x.id !== op.id)) {
      problems += 1;
      console.log(`  COLLISION auth.users email ${(op.row as Row).email} is held by a non-fixture user`);
    }
  }
  for (const op of ops.filter((o) => o.table === "public.venues" && o.row?.is_default)) {
    const r = await q("select id::text id from public.venues where tenant_id = $1 and is_default", [op.row?.tenant_id]);
    if (r.rows.find((x) => x.id !== op.id)) {
      problems += 1;
      console.log("  COLLISION a fixture workspace already has a default venue that is not this seed's");
    }
  }
  return problems;
}

// ------------------------------------------------------------------ main
async function main() {
  console.log(`${TAG} target OK (staging fxlankepwnvelxjrahwk). mode=${mode} clusters=${sets.join(",")}`);
  await q(mode === "plan" || mode === "cleanup-plan" ? "begin read only" : mode === "selftest" ? "begin isolation level repeatable read" : "begin");
  const ctx = await context();
  const plan = buildStage2Plan(sets, ctx);
  const ops = plan.ops as Op[];
  const v = verifyS2Plan(ops, guardCtx());
  if (!v.ok) throw new Error(`plan refused:\n  - ${v.problems.join("\n  - ")}`);
  console.log(`${TAG} plan guards OK: ${ops.length} ops across ${v.tenantIds.size} fixture workspaces`);

  if (mode === "plan" || mode === "cleanup-plan") {
    console.log(`${TAG} rows by table (insert / update of this seed's own rows):`);
    for (const [t, c] of Object.entries(summarise(ops))) console.log(`  ${t.padEnd(38)} ${String(c.insert).padStart(3)} / ${c.update}`);
    const p = await presentCount(ops);
    console.log(`${TAG} fixture rows already present: ${p.present}/${p.total}`);
    for (const [t, s] of Object.entries(p.byTable)) console.log(`  ${t.padEnd(38)} ${s}`);
    const problems = await schemaAndCollisions(ops);
    console.log(`${TAG} schema + collision check: ${problems === 0 ? "OK" : `${problems} PROBLEM(S)`}`);
    const pos = await q("select workspace_pos_enabled from public.platform_settings limit 1").catch(() => null);
    console.log(`${TAG} platform kill switch platform_settings.workspace_pos_enabled (shared platform row, NOT written by this seed): ${pos?.rows[0] ? String(pos.rows[0].workspace_pos_enabled) : "unreadable"}`);
    const touching = ops.filter((o) => o.touchesExisting);
    console.log(`${TAG} touches pre-existing TAL-93900 (additive new rows only, no updates): ${touching.length}`);
    for (const o of touching) console.log(`  ${o.table.padEnd(30)} ${o.key}`);
    for (const n of plan.notes) console.log(`${TAG} note: ${n}`);
    for (const b of plan.blocked) console.log(`${TAG} BLOCKED by held migration ${b.version} (${b.file}): ${b.item}`);
    for (const n of plan.notBuilt) console.log(`${TAG} NOT BUILT yet [${n.id}] ${n.what} (${n.why})`);
    await q("rollback");
    console.log(mode === "plan" ? `${TAG} DRY RUN: nothing written.` : `${TAG} cleanup plan only: nothing deleted.`);
    if (problems) process.exitCode = 1;
    return;
  }
  try {
    if (mode === "cleanup-apply") {
      await cleanup(ops, true);
      saveBackup();
      const left = await presentCount(ops);
      if (left.present) throw new Error(`${left.present} fixture rows remain after cleanup`);
      await q("commit");
      console.log(`${TAG} cleanup committed; deleted-row images in the backup file`);
      return;
    }
    if (mode === "selftest") {
      secrets = resolveSecrets(ops); // ephemeral: never written to disk
    } else {
      secrets = resolveSecrets(ops, loadSeedConfig());
      writeSeedConfig(secrets); // local, mode 600, gitignored; extended, never printed
      console.log(`${TAG} credentials written to the local seed config (${SEED_CONFIG_PATH.replace(/^.*\/web\//, "web/")}); values are never printed`);
    }
    const before = mode === "selftest" ? await tableCounts() : null;
    const startedClean = (await presentCount(ops)).present === 0;
    await runOps(ops);
    console.log(`${TAG} rows (created / already present / updated):`);
    for (const [t, c] of Object.entries(counts)) console.log(`  ${t.padEnd(38)} ${c.created} / ${c.existed} / ${c.updated}`);
    if (before) {
      const mid = await tableCounts();
      console.log(`${TAG} selftest: table row deltas after the writes (incl. trigger side effects):`);
      for (const t of COUNT_TABLES) if (mid[t] !== before[t]) console.log(`  ${t.padEnd(38)} +${mid[t] - before[t]}`);
    }
    const after = await presentCount(ops);
    console.log(`${TAG} read-back: ${after.present}/${after.total} fixture ids present`);
    const rb = await readBack(q, sets);
    for (const line of rb.lines) console.log(`  ${line}`);
    if (after.present !== after.total || rb.failures) throw new Error(`read-back failed (${after.total - after.present} ids missing, ${rb.failures} checks failed)`);
    if (mode === "selftest" && before) {
      await cleanup(ops, false);
      const end = await tableCounts();
      const drift = startedClean ? COUNT_TABLES.filter((t) => before[t] !== end[t]).map((t) => `${t} ${before[t]} -> ${end[t]}`) : [];
      const left = (await presentCount(ops)).present;
      console.log(`${TAG} selftest: cleanup left ${left} fixture rows; row-count drift: ${drift.length ? drift.join("; ") : startedClean ? "none" : "skipped (fixtures were already committed)"}`);
      await q("rollback");
      await q("begin read only");
      const post = (await presentCount(ops)).present;
      await q("rollback");
      console.log(`${TAG} selftest: after ROLLBACK, fixture rows on staging: ${post} (expected ${startedClean ? 0 : "unchanged"})`);
      if (left || drift.length || (startedClean && post)) process.exitCode = 1;
      else console.log(`${TAG} selftest OK; everything rolled back, nothing persisted`);
      return;
    }
    saveBackup();
    await q("commit");
    console.log(`${TAG} COMMITTED. backup: ${backupFile} (${backup.updated.length} pre-existing rows changed)`);
  } catch (e) {
    await q("rollback").catch(() => undefined);
    throw e;
  }
}

try {
  await main();
} catch (e) {
  console.error(`${TAG} FAILED (rolled back): ${e instanceof Error ? e.message : "unknown error"}`);
  process.exitCode = 1;
} finally {
  await client.end();
}
