NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only: required on deployed hosts for Admin → Users “Generate new password” (auth.admin.updateUserById).
# Supabase Dashboard → Project Settings → API → service_role (secret). Never use NEXT_PUBLIC_ or commit real values.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: image upload script — npm run generate:talent-images | generate-talent-images-free
# Flags: --kind=card|banner|both  --offset=N  --limit=N  (split across terminals)
# Auto: OpenAI if OPENAI_API_KEY is set, else Pollinations (free, no key — rate limits apply).
# IMAGE_GEN_PROVIDER=pollinations   # AI, often 429
# IMAGE_GEN_PROVIDER=picsum         # stock photos, reliable demos (npm run generate-talent-images-stock)
# IMAGE_GEN_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# Optional: Phase 9 — `npm run embed-talents`; with `ai_search_enabled` the public directory uses `POST /api/ai/search` (hybrid). `ai_refine_enabled` shows refine chips (`POST /api/ai/refine-suggestions`).
# Same key as image scripts; uses text-embedding-3-small (1536-dim).
#
# --- AI chat provider (NLU, inquiry draft, translations, interpret-search) ---
# Admin → AI settings: provider registry + optional encrypted agency keys (requires AI_CREDENTIALS_ENCRYPTION_KEY).
# Platform keys can still come from the environment below.
# If `usedInterpreter` is always false, check API field `interpretFailureCode` and server logs (`interpret_search_*`).
# Common: `no_key` (no resolved key for the default provider).
# Default provider is chosen in Admin → AI settings (registry); optional env override:
# Optional: force provider regardless of DB (openai | anthropic).
# AI_PROVIDER=openai
# When using Anthropic (Claude), set:
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_CHAT_MODEL=claude-sonnet-4-20250514
# Required to store agency API keys from the dashboard (base64 of 32 random bytes).
# openssl rand -base64 32
# AI_CREDENTIALS_ENCRYPTION_KEY=

# Optional: chat model for OpenAI paths. Default: gpt-4o-mini
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_IMAGE_MODEL=dall-e-3
# POLLINATIONS_MODEL=flux   # optional; see pollinations.ai
# POLLINATIONS_DELAY_MS=7000   # pause between images (free tier / 429)
# POLLINATIONS_MAX_RETRIES=10  # retries per image on 429/502/503
# Used in auth callbacks and OAuth redirects (no trailing slash).
# On Vercel, set to your deployment URL (https://…), not localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:4000

# --- Connection OAuth (talent/client/workspace social verification) ---
# Required for one-click YouTube verification in Talent, Client, and Workspace settings.
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web application).
# Add redirect URI: ${NEXT_PUBLIC_APP_URL or NEXT_PUBLIC_SITE_URL}/api/connections/oauth/callback/google
# Enable YouTube Data API v3 and keep these server-only.
# CONNECTION_OAUTH_STATE_SECRET must be a random 32+ character value.
# CONNECTION_OAUTH_STATE_SECRET=
# GOOGLE_CONNECTION_OAUTH_CLIENT_ID=
# GOOGLE_CONNECTION_OAUTH_CLIENT_SECRET=

# --- Vercel project domain sync (Phase 4 custom domains) ---
# Optional in local dev. Required when you want the domain actions to
# auto-attach/remove custom domains on the linked Vercel project.
# VERCEL_API_TOKEN=  # or VERCEL_TOKEN
# VERCEL_PROJECT_ID=
# Optional if token belongs to a team workspace:
# VERCEL_TEAM_ID=
# VERCEL_TEAM_SLUG=

# --- Cron authentication (publish scheduler / inquiry engine / domain verification) ---
# REQUIRED in production. Vercel cron forwards Authorization: Bearer <CRON_SECRET>.
# Without this set, all /api/cron/* routes return 503. Keep server-only and
# identical across the cron-protected routes. Audit H12 — query-param token
# was removed; only the Authorization header is honored.
CRON_SECRET=

# --- Stripe billing + payouts (Phase 8.x) ---
# REQUIRED for any billing/payout flow to work. Without STRIPE_SECRET_KEY,
# isStripeConfigured() returns false: checkout returns mock URLs and Connect
# transfers resolve to 'mock' (no real money moves). Use sk_test_/pk_test_ for the
# sandbox; sk_live_/pk_live_ only in production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Browser publishable key — REQUIRED client-side or the embedded Connect onboarding
# (<ConnectEmbeddedOnboarding>) cannot mount (talent + agency onboarding silently fail).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Stripe v2 Global Payouts (only when the platform payout switch = global_payouts).
# On a test key the v2 client falls back to STRIPE_SECRET_KEY, so leave these unset
# for Connect-only sandbox QA.
# STRIPE_V2_SECRET_KEY=
# STRIPE_V2_WEBHOOK_SECRET=
# LIVE-key payout kill switch. Irrelevant on sk_test_ (never "live"). If Connect is
# ever pointed at sk_live_, transfers HOLD as skipped_live_disabled until this is
# exactly "true". Do NOT set it on the sandbox.
# STRIPE_ALLOW_LIVE_PAYOUTS=true
# Workspace plan price IDs (Phase 8.1) — set per Stripe Dashboard.
STRIPE_PRICE_STUDIO_MONTHLY=
STRIPE_PRICE_STUDIO_ANNUAL=
STRIPE_PRICE_AGENCY_MONTHLY=
STRIPE_PRICE_AGENCY_ANNUAL=
# Network is sales-assisted today; leave blank unless flipping to self-serve.
STRIPE_PRICE_NETWORK_MONTHLY=
STRIPE_PRICE_NETWORK_ANNUAL=
# Talent personal-page price IDs (Phase 8.2).
STRIPE_PRICE_TALENT_PRO_MONTHLY=
STRIPE_PRICE_TALENT_PRO_ANNUAL=
STRIPE_PRICE_TALENT_PORTFOLIO_MONTHLY=
STRIPE_PRICE_TALENT_PORTFOLIO_ANNUAL=

# --- Analytics (optional) ---
# GA4 browser tag (public). Consent banner controls storage; modeled data may apply when denied.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# GA4 Data API + Realtime (server-only JSON service account key — never commit).
# GA4_PROPERTY_ID=123456789
# GOOGLE_ANALYTICS_CREDENTIALS_JSON={"type":"service_account",...}
# Google Search Console API (same or separate service account with Search Console permission).
# GSC_SITE_URL=https://www.example.com/
# GOOGLE_SEARCH_CONSOLE_CREDENTIALS_JSON={"type":"service_account",...}

# Optional: `npm run verify:deploy-env` with DEPLOY_ENV_STRICT=1 also requires NEXT_PUBLIC_SITE_URL
# (use before pushing to Vercel so OAuth/metadata are correct).
# DEPLOY_ENV_STRICT=1

# --- Google Places (country + city autocomplete in canonical location fields; server-side only) ---
# Console: https://console.cloud.google.com/google/maps-apis
# 1) Enable billing on the project.
# 2) Enable "Places API" (legacy Autocomplete + Place Details endpoints used by the app).
# 3) Create an API key; Application restriction: "None" (dev) or "IP addresses" (production server).
#    Avoid "HTTP referrers" for this key — Places calls are made from Node, not the browser.
# 4) Copy the key here. You do NOT need the Maps "URL signing secret" for this feature.
GOOGLE_PLACES_API_KEY=

# Homepage map (Maps JavaScript API in the browser). If unset, the server passes GOOGLE_PLACES_API_KEY.
# Same GCP key works only if: (1) "Maps JavaScript API" is enabled, (2) billing is on, and (3) the key allows
# browser use — IP-restricted keys (typical for server Places) block the map; add HTTP referrers such as
# http://localhost:3000/* and your production origin, or use a separate browser key:
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# After editing, restart `npm run dev`. Quick check (does not print secrets): `npm run verify:google-maps-env`
# Optional: BCP-47 language for Places text (default en)
# GOOGLE_PLACES_LANGUAGE=en

# Optional: when `1`, missing `settings` rows default directory + inquiries to **closed** (stricter prod).
# Default: unset (missing keys keep directory/inquiries open until admins seed toggles).
# PUBLIC_SETTINGS_STRICT_MISSING=1

# Optional: force legacy client-assembled directory search (skip Postgres RPC). For local debugging or
# emergency rollback without redeploying. Default: unset (use RPC `directory_search_public_talent_ids`).
# DIRECTORY_SEARCH_FORCE_LEGACY=1

# Optional: JSON timing logs for `/api/directory` + `fetchDirectoryPage` (stdout). For performance audits only.
# DIRECTORY_API_AUDIT=1

# Optional: local verification scripts (never commit real passwords)
# TALENT_EMAIL=talent@example.com
# TALENT_PASSWORD=your-test-password
# npm run create:test-admin — optional overrides (defaults: qa-admin@impronta.test / Impronta-QA-Admin-2026!)
# TEST_ADMIN_EMAIL=qa-admin@impronta.test
# TEST_ADMIN_PASSWORD=
# TEST_ADMIN_DISPLAY_NAME=QA Admin

# --- Super-admin workspace impersonation (QA talent/client dashboards; v1 read-only) ---
# Random secret (e.g. openssl rand -hex 32). Required to set/sign the HttpOnly cookie.
# IMPERSONATION_COOKIE_SECRET=
# UUIDs of real users (profiles.id = auth.users.id) with app_role talent / client, account active.
# IMPERSONATION_QA_TALENT_USER_ID=
# IMPERSONATION_QA_CLIENT_USER_ID=

# --- Invite-link tokens (Phase 5/6 M5) ---
# Random secret (e.g. openssl rand -hex 32). Required to sign/verify /invite/[token] links.
# Links are HMAC-SHA256 signed; rotating this secret invalidates in-flight invites.
# INVITE_TOKEN_HMAC_SECRET=

# --- Preview JWT (M8 draft-state iframe preview) ---
# HS256 secret for signing short-lived preview tokens (see
# src/lib/site-admin/preview/jwt.ts). Must be at least 32 chars.
# Rotation invalidates in-flight preview sessions (acceptable — 15-min TTL).
# Also used to sign Pitch share-link tokens (see src/lib/pitch/pitch-share-token.ts).
# PREVIEW_JWT_SECRET=

# --- Pitch share-link base URL (Phase 9 — pitch feature) ---
# Public origin used to build /share/pitch/[token] URLs sent over WhatsApp/email.
# Defaults to https://tulala.digital. Override only if pitches need a tenant-specific
# host (e.g. for white-label deployments). Must NOT include a trailing slash.
# PITCH_PUBLIC_BASE_URL=https://tulala.digital

# --- Email (Resend) ---
# Transactional emails: offer sent, booking confirmed, talent invited.
# Dashboard: resend.com → API Keys. Keep server-only — never expose in browser bundles.
# If unset, email sends are skipped silently (console warning).
# RESEND_API_KEY=re_...
# Sender address (must be a verified domain in your Resend workspace).

# --- Support Center channels (M3). All no-op when unset. ---
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@tulala.digital
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# SUPPORT_OWNER_WHATSAPP_TO=whatsapp:+15555555555
# Bearer token for GET /api/platform/support/tickets/:id/investigation-bundle
# (optional; platform-admin session also works).
# SUPPORT_INVESTIGATION_TOKEN=
# SUPPORT_REPLAY_RETENTION_DAYS=30
# REAP_SUPPORT_REPLAYS_ENABLED=false

# Sender address (must be a verified domain in your Resend workspace).
# EMAIL_FROM=Impronta <noreply@impronta.com>
# Optional Reply-To used on transactional mail (e.g. the /get-started confirmation).
# EMAIL_REPLY_TO=hello@impronta.com
# Founder/admin inbox that receives a notification for every /get-started signup.
# FOUNDER_NOTIFY_EMAIL=you@example.com
# Salt mixed into the SHA-256 of the signup IP before it's stored (ip_hash).
# Change on rotation; stored hashes become opaque to the old address space.
# SIGNUP_IP_SALT=impronta-signup-v1

# Optional: Postgres URL for local tooling only (e.g. npm run validate:inquiry-workspace-db). Not used by Next.js.
# Supabase → Project Settings → Database → Connection string. Never commit real credentials.
# The validation script uses `psql` when installed; otherwise it uses Node + the `pg` devDependency (no psql required).
# Use the Database password from that screen (not the anon or service_role JWT). Re-copy after a DB password reset.
#
# Supabase database URIs — copy the full line from Project Settings → Database for the tab you use.
# Do not mix user/host/port between tabs. Replace [YOUR-PASSWORD] with your real database password.
#
# Direct connection: user `postgres`, host `db.<project-ref>.supabase.co`, port 5432 (IPv4 and IPv6).
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_REF.supabase.co:5432/postgres?sslmode=require
#
# Session pooler (Shared pooler, IPv4): user `postgres.<project-ref>`, host `aws-...pooler.supabase.com`, port 5432
# DATABASE_URL=postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres?sslmode=require
#
# Transaction pooler: user `postgres.<project-ref>`, same pooler-style host, port often 6543
# DATABASE_URL=postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
#
# `npm run validate:inquiry-workspace-db` (Node + pg) adds Supabase TLS + uselibpqcompat for *.supabase.com automatically.

# ── Page Builder feature flags ────────────────────────────────────────────────
# NEXT_PUBLIC_BUILDER_CLIENT_CANVAS was deleted (builder-2027 P1). The
# client-rendered canvas is now the only editor path on every surface; the
# server-rendered editor fallback it gated is gone. The variable can be removed
# from Vercel — nothing reads it.
# Figma-style live multiplayer presence in the builder (avatars, remote cursors,
# conflict banner). Off → presence UI is hidden.
NEXT_PUBLIC_BUILDER_PRESENCE=1
# Builder canvas profiler boundaries (dev/perf only). 1 → wraps the canvas + chrome
# in React profiler boundaries to measure per-edit reconcile cost. Leave 0 in prod.
NEXT_PUBLIC_BUILDER_PROFILE=0

# ── Media ownership phase 2 — per-hub faces ─────────────────────────────────
# Tenant-aware talent card photos. OFF (unset / 0) → every card resolves the
# global variant rank exactly as before phase 2, so output is byte-identical.
# 1 or true → a workspace's roster-drawer curation ("Photos on this site":
# agency_talent_media + agency_talent_overlays.cover_media_asset_id) decides the
# face on that workspace's own surfaces; uncurated talents still fall back to
# the global rank, and the master surfaces (global Discover, the talent's own
# dashboard) are unaffected. Flip in Vercel → Project → Settings → Environment
# Variables, then redeploy.
# See web/docs/media-ownership-and-brand-library-plan-2026-08-10.md §8.
MEDIA_PER_HUB_FACES_ENABLED=0

# ── Media ownership phase 3 — two-key grants ────────────────────────────────
# Enforces the two-key rule (plan §P2): an asset appears on a hub only if the
# OWNER allows that hub AND the SUBJECT of the photo allows it. OFF (unset / 0)
# → the resolver returns exactly what phase 2 returns; media_grants is written
# by the release flows but never read, so requests/approvals can be exercised
# before enforcement goes live.
# 1 or true → the resolver filters every candidate through the SQL predicate
# media_asset_presentable_on_tenant() (migration 20261115000000). Defaults are
# IMPLICIT: an agency photo still shows on its own hub, a talent's own photos
# still show on every hub that rosters them, and the master profile is
# unchanged — so turning this on with an empty media_grants table changes
# nothing visible. Grants are only needed for a THIRD hub.
# Independent of MEDIA_PER_HUB_FACES_ENABLED on purpose: curation is a
# presentation change, enforcement is a visibility change, and they deserve
# separate QA before separate flips.
# REQUIRES migration 20261115000000_media_grants_two_key.sql to be applied.
MEDIA_TWO_KEY_GRANTS_ENABLED=0

# ── Site shell (global header + footer) ─────────────────────────────────────
# TWO INDEPENDENT GATES, on purpose. One controls what the PUBLIC SITE renders,
# the other controls whether the EDITOR can open the shell surface. Keeping them
# separate lets QA edit a shell without flipping live rendering (and vice versa).
#
# 1. RENDER gate — does the public storefront paint the snapshot-rendered shell
#    instead of the hard-coded PublicHeader / PublicCmsFooterNav?
#      unset | 0 | false → off for every tenant (default)
#      tenants           → only tenants listed in SITE_SHELL_TENANT_IDS
#      1 | true | all    → every tenant
#    NOTE: Impronta (00000000-0000-0000-0000-000000000001) is ALSO enabled by a
#    code-level launch allow-list in src/lib/site-admin/site-shell-flag.ts, so it
#    renders the snapshot shell regardless of what these env vars say.
#    A belt still applies everywhere: a tenant with no PUBLISHED shell row falls
#    back to the legacy header, so a green flag never yields empty chrome.
ENABLE_SITE_SHELL=0
# Comma-separated tenant UUIDs. Only read when ENABLE_SITE_SHELL=tenants.
SITE_SHELL_TENANT_IDS=
#
# 2. EDIT gate — may the builder open the `site_shell` SURFACE (load / edit /
#    save / publish the freeform shell tree)? Same three states as above, read in
#    shouldRouteSiteShellSurface() and consumed at exactly one call site
#    (src/components/edit-chrome/edit-chrome-mount.tsx).
#      unset | 0 | false → surface never mounts (default); the editor falls back
#                          to the legacy header-selection special case
#      tenants           → only tenants listed in SITE_SHELL_EDIT_TENANT_IDS
#      1 | true | all    → every tenant
#    Turning this ON does NOT change anything the public site renders.
#    Local QA: set this to 1 in web/.env.local, then reach the surface from the
#    workspace Website admin's "Site header & footer" entry point.
ENABLE_SITE_SHELL_EDIT=0
# Comma-separated tenant UUIDs. Only read when ENABLE_SITE_SHELL_EDIT=tenants.
SITE_SHELL_EDIT_TENANT_IDS=
