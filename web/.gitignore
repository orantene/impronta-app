# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Builder fidelity harness capture output (regenerated; contains machine-local file:// HTML)
/fidelity/

# Stripe target key-sets for scripts/stripe-target.mjs (hold secrets)
.env.stripe.*

# AI builder eval harness output (regenerable QA artifacts)
/public/_eval/
/eval/generate-runs/
/scripts/ai-builder-eval/screenshots/
.worktree-owner
